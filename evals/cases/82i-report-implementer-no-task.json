{
  "name": "report-check: implementer without TASK blocked",
  "kind": "hook",
  "hook": "subagent-report-check.sh",
  "capture": "all",
  "payload": {
    "hook_event_name": "SubagentStop",
    "agent_type": "implementer",
    "last_assistant_message": "RESULT: done\n\nTest: bash evals/run.sh → red / green\nFiles: a.sh\nDeviation cause: none",
    "stop_hook_active": false
  },
  "expect_exit": 2,
  "contains": "TASK: <slug>/T<n>"
}
